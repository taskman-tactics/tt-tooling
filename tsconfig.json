{
	"$schema": "https://www.schemastore.org/tsconfig",
	"extends": ["@tsconfig/bun/tsconfig.json"],
	"compilerOptions": {
		"strictNullChecks": true,
		"paths": {
			"@/*": ["./src/*"],
			"@t/*": ["./src/territories/*"]
		},
		"typeRoots": ["./node_modules/@types", "./node_modules/@stdlib/types"]
	},
	"include": ["./src/**/*.mts"]
}
